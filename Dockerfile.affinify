FROM ghcr.io/open-webui/open-webui:main

# Copiar arquivos de integração Affinify
COPY backend/open_webui/utils/prodify_sync.py /app/backend/open_webui/utils/
COPY backend/open_webui/utils/credits.py /app/backend/open_webui/utils/
COPY backend/open_webui/utils/affinify_init.py /app/backend/open_webui/utils/
COPY backend/open_webui/routers/prodify_auth.py /app/backend/open_webui/routers/
COPY backend/open_webui/routers/credits.py /app/backend/open_webui/routers/
COPY custom-branding/credits-display.js /app/build/static/js/credits-affinify.js
COPY custom-branding/fix-login-form.js /app/build/static/js/

# Adicionar scripts no HTML
RUN sed -i 's|<head>|<head><script src="/static/js/fix-login-form.js"></script>|g' /app/build/index.html && \
    sed -i 's|</head>|<script src="/static/js/credits-affinify.js" defer></script></head>|g' /app/build/index.html

# Modificar main.py para carregar Affinify
RUN python3 << 'PYTHON_SCRIPT'
import re
main_path = "/app/backend/open_webui/main.py"
with open(main_path, 'r') as f:
    content = f.read()

if 'Affinify Integration' not in content:
    pattern = r'(app = FastAPI\([^)]*\))'
    match = re.search(pattern, content, re.DOTALL)
    if match:
        insert_pos = match.end()
        affinify_code = '''

# Affinify Integration
try:
    from open_webui.utils import affinify_init
    affinify_init.init_affinify_routes(app)
except Exception as e:
    import logging
    logging.getLogger(__name__).error(f'Affinify error: {e}')
'''
        content = content[:insert_pos] + affinify_code + content[insert_pos:]
        with open(main_path, 'w') as f:
            f.write(content)
        print("✅ Affinify integration added to main.py")
PYTHON_SCRIPT

CMD ["bash", "start.sh"]

